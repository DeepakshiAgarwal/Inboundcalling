# Copy to .env and fill in. Never commit .env.
METABASE_URL=
# Leave empty on this PC: the encrypted ~/.metabase_key is used. Set it on a server.
METABASE_API_KEY=
METABASE_DATABASE_ID=113

# Wiom Net queue as it appears in QUEUE_NAME (verify_live.py lists the names)
WIOM_NET_QUEUE=Wiom_Net_Queue

# Team login. Required when hosted, optional on your own computer.
APP_USERNAME=
APP_PASSWORD=

# 1 = double-click lists exactly the calls a cell counts (the original leaves out Wiom Net calls)
DRILL_MATCH_CELL=0

# Folder for store.json. On Railway, point it at a mounted volume, e.g. /data
DATA_DIR=
